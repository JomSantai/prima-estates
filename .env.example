# ---- Prima Estates environment variables ----
# Copy the relevant ones into Railway's "Variables" tab. Do NOT commit real values.

# Railway's Postgres plugin sets DATABASE_URL automatically - you usually don't set this yourself.
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# Admin login (CHANGE THESE - they seed the first admin account on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# Cloudinary (from your Cloudinary dashboard -> "API Environment variable")
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Standard ASP.NET
ASPNETCORE_ENVIRONMENT=Production
